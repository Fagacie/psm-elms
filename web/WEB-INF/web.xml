<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    
    <display-name>PSM E-Learning Platform</display-name>
    <description>
        PSM E-Learning Platform - A comprehensive learning management system
    </description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Authentication Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.ChangePasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <url-pattern>/change-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfilePictureServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.ProfilePictureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfilePictureServlet</servlet-name>
        <url-pattern>/profile-picture</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MailTestServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.MailTestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MailTestServlet</servlet-name>
        <url-pattern>/mail-test</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserManagementServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.admin.UserManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserManagementServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <!-- Course Management Servlets -->
    <servlet>
        <servlet-name>InstructorCourseServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.instructor.InstructorCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InstructorCourseServlet</servlet-name>
        <url-pattern>/instructor/courses</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminCourseServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.admin.AdminCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminCourseServlet</servlet-name>
        <url-pattern>/admin/courses</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentCourseServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.StudentCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentCourseServlet</servlet-name>
        <url-pattern>/student/courses</url-pattern>
    </servlet-mapping>

    <!-- Enrollment & Payment Servlets -->
    <servlet>
        <servlet-name>ProcessEnrollmentServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.ProcessEnrollmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProcessEnrollmentServlet</servlet-name>
        <url-pattern>/student/enroll</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PaymentPageServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.PaymentPageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentPageServlet</servlet-name>
        <url-pattern>/student/payment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PaymentCallbackServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.PaymentCallbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentCallbackServlet</servlet-name>
        <url-pattern>/student/payment-callback</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PaymentSuccessServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.PaymentSuccessServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentSuccessServlet</servlet-name>
        <url-pattern>/student/payment-success</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PaymentFailedServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.PaymentFailedServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentFailedServlet</servlet-name>
        <url-pattern>/student/payment-failed</url-pattern>
    </servlet-mapping>

    <!-- New Enrollment Summary & Payment Start Servlets -->
    <servlet>
        <servlet-name>EnrollmentSummaryServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.EnrollmentSummaryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EnrollmentSummaryServlet</servlet-name>
        <url-pattern>/student/enrollment-summary</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>StartPaymentServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.StartPaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StartPaymentServlet</servlet-name>
        <url-pattern>/student/start-payment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyEnrollmentsServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.MyEnrollmentsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyEnrollmentsServlet</servlet-name>
        <url-pattern>/student/my-enrollments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EnrollmentDetailsServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.student.EnrollmentDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EnrollmentDetailsServlet</servlet-name>
        <url-pattern>/student/enrollment-details</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminEnrollmentListServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.admin.AdminEnrollmentListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminEnrollmentListServlet</servlet-name>
        <url-pattern>/admin/enrollments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminEnrollmentDetailsServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.admin.AdminEnrollmentDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminEnrollmentDetailsServlet</servlet-name>
        <url-pattern>/admin/enrollment-details</url-pattern>
    </servlet-mapping>

    <!-- Admin Payment Servlets -->
    <servlet>
        <servlet-name>AdminPaymentListServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.admin.AdminPaymentListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPaymentListServlet</servlet-name>
        <url-pattern>/admin/payments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminPaymentDetailServlet</servlet-name>
        <servlet-class>com.psm.elearning.controller.admin.AdminPaymentDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPaymentDetailServlet</servlet-name>
        <url-pattern>/admin/payment</url-pattern>
    </servlet-mapping>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <!-- Startup initializer to run lightweight DB migrations -->
    <listener>
        <listener-class>com.psm.elearning.init.AppInitializer</listener-class>
    </listener>

    <!-- Security Constraints (Optional - can be configured later) -->
    <!--
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected Area</web-resource-name>
            <url-pattern>/dashboard/*</url-pattern>
