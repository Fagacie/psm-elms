# Database Configuration for PSM E-Learning Platform
# MySQL JDBC Connection Properties
# COPY THIS FILE TO db.properties AND UPDATE WITH YOUR CREDENTIALS

# MySQL JDBC Driver
db.driver=com.mysql.cj.jdbc.Driver

# Database URL (modify host and port if needed)
db.url=jdbc:mysql://localhost:3306/psm_elearning?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Database Credentials (CHANGE THESE)
db.username=root
db.password=your_database_password_here

# HikariCP Connection Pool Settings
db.pool.maxActive=20
db.pool.minIdle=5
db.pool.connectionTimeout=30000
db.pool.idleTimeout=600000
db.pool.maxLifetime=1800000
